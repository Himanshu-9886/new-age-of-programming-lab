ackage main

import "fmt"

type Student struct {
	Name  string
	Marks float32
}

func change(a *int) {
	*a = 15
}

func main() {
	a := 17

	fmt.Println(a)
	fmt.Println(&a)
	fmt.Println(*(&a))

	fmt.Println("Before change:", a)
	change(&a)
	fmt.Println("After change:", a)

	s := new(Student)

	s.Name = "XYZ"
	s.Marks = 90.5

	fmt.Println(s.Name)
	fmt.Println(s.Marks)

	s.Marks = 89
	fmt.Println(s.Marks)
}

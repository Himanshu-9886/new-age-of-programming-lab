

fun main() {

    // (1) Hello Kotlin
    println("Hello Kotlin!!!")

    // (2) Employee Bonus
    val dept_code = "IT"
    val experience = 6
    val salary = 30000.0

    val bonusPercent = when {
        dept_code == "IT" && experience > 5 -> 20
        dept_code == "HR" && experience > 3 -> 15
        dept_code == "Sales" && experience > 2 -> 12
        else -> 10
    }

    val bonus = salary * bonusPercent / 100

    println("\nEmployee Bonus Details")
    println("Department: $dept_code")
    println("Experience: $experience years")
    println("Bonus Percentage: $bonusPercent%")
    println("Bonus Amount: $bonus")

    // (3) Average of Individual Digits
    print("\nEnter an integer: ")

    val input = readLine()

    if (input != null && input.toIntOrNull() != null) {

        var num = kotlin.math.abs(input.toInt())

        var sum = 0
        var count = 0

        if (num == 0) {
            count = 1
        }

        while (num > 0) {
            val digit = num % 10
            sum += digit
            count++
            num /= 10
        }

        val average = sum.toDouble() / count

        println("Average of digits: $average")

    } else {
        println("Please enter a valid integer")
    }
}

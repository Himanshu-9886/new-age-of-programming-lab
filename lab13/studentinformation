
class Student(
    private var rollNo: Int,
    private var name: String,
    private var course: String,
    private var percentage: Double
) {

    // Function to accept student data
    fun acceptData() {
        print("Enter Roll Number: ")
        rollNo = readln().toInt()

        print("Enter Name: ")
        name = readln()

        print("Enter Course: ")
        course = readln()

        print("Enter Percentage: ")
        percentage = readln().toDouble()
    }

    // Function to display student details
    fun displayData() {
        println("\n----- Student Details -----")
        println("Roll Number: $rollNo")
        println("Name: $name")
        println("Course: $course")
        println("Percentage: $percentage%")
    }
}

fun main() {

    val student1 = Student(0, "", "", 0.0)

    println("Enter First Student Details")
    student1.acceptData()
    student1.displayData()

    val student2 = Student(0, "", "", 0.0)

    println("\nEnter Second Student Details")
    student2.acceptData()
    student2.displayData()
}

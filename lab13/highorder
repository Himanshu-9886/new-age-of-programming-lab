
fun main() {

    // (1) Function with default parameters
    fun student(name: String = "Himanshu", age: Int = 19) {
        println("Name: $name")
        println("Age: $age")
    }

    println("Default Parameters:")
    student() 
    student("Rahul", 20)

    // (2) Function using named arguments
    println("\nNamed Arguments:")
    student(age = 21, name = "Aman")

    // (3) Function using vararg
    fun printNumbers(vararg numbers: Int) {
        println("\nVararg Numbers:")
        for (num in numbers) {
            println(num)
        }
    }

    printNumbers(10, 20, 30, 40, 50)

    // (4) Higher-order function using lambda
    fun calculate(numbers: List<Int>, operation: (Int) -> Int) {
        println("\nHigher Order Function:")
        for (num in numbers) {
            println(operation(num))
        }
    }

    val list = listOf(1, 2, 3, 4, 5)

    calculate(list) { it * 2 }
}
